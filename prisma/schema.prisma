datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum EntryVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum CommentPolicy {
  ENABLED
  FRIENDS_ONLY
  DISABLED
}

enum EntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProfileVisibility {
  PRIVATE
  MEMBERS
  PUBLIC
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum FeedbackCategory {
  BUG
  CONTENT_REQUEST
  FEATURE_REQUEST
  GENERAL
}

enum RewardStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  REWARDED
  DISQUALIFIED
}

model User {
  id                 String                 @id @default(cuid())
  clerkId            String?                @unique
  name               String?
  username           String?                @unique
  bio                String?
  email              String?                @unique
  password           String?
  image              String?
  timezone           String                 @default("America/Chicago")
  isProfilePublic    Boolean                @default(true)
  profileVisibility  ProfileVisibility      @default(PUBLIC)
  showEmailOnProfile Boolean                @default(false)
  allowNsfwStories   Boolean                @default(false)
  favoriteGenres     String[]               @default([])
  mutedGenres        String[]               @default([])
  feedIncludesPublic Boolean                @default(true)
  feedIncludesFriends Boolean               @default(true)
  feedIncludesPrompts Boolean               @default(true)
  dailyTargetWords  Int                     @default(500)
  streakGoalDays    Int                     @default(7)
  showProfileSection Boolean                @default(true)
  showPreferencesSection Boolean            @default(true)
  showFeedSection Boolean                   @default(true)
  showGoalsSection Boolean                  @default(true)
  showFriendsSection Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  accounts           Account[]
  sessions           Session[]
  entries            Entry[]
  entrySeries        EntrySeries[]
  wordGoals          WordGoal[]
  customGoals        CustomGoal[]
  dailyProgress      DailyProgress[]
  promptAssignments  UserPromptAssignment[]
  feedbackSubmissions FeedbackSubmission[]
  writingPrompts     WritingPrompt[]
  promptVotes        PromptVote[]
  promptUsageEvents  PromptUsageEvent[]
  likes              EntryLike[]
  comments           EntryComment[]
  hiddenEntries      HiddenEntry[]
  sentFriendRequests Friendship[]           @relation("FriendshipRequester")
  receivedFriends    Friendship[]           @relation("FriendshipAddressee")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  type              String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomGoal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted, createdAt])
}

model WordGoal {
  id                String          @id @default(cuid())
  userId            String
  title             String
  description       String?
  dailyTargetWords  Int             @default(500)
  streakGoalDays    Int             @default(7)
  isActive          Boolean         @default(true)
  startDate         DateTime
  endDate           DateTime?
  currentStreakDays Int             @default(0)
  bestStreakDays    Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressDays      DailyProgress[]

  @@index([userId, isActive])
}

model DailyProgress {
  id              String                @id @default(cuid())
  userId          String
  goalId          String
  date            DateTime
  wordsWritten    Int                   @default(0)
  targetWords     Int
  goalMet         Boolean               @default(false)
  streakDayNumber Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            WordGoal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  entryCredits    EntryProgressCredit[]

  @@unique([userId, date])
  @@index([goalId, date])
}

model Prompt {
  id              String                 @id @default(cuid())
  title           String
  body            String
  genre           String
  tags            String[]
  isFeatured      Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  assignments     UserPromptAssignment[]
  promptedEntries Entry[]                @relation("PromptResponses")

  @@index([genre, isFeatured])
}

model FeedbackSubmission {
  id                     String             @id @default(cuid())
  userId                 String
  category               FeedbackCategory
  subject                String?
  body                   String
  attachmentUrl          String?
  attachmentName         String?
  attachmentMimeType     String?
  attachmentSizeBytes    Int?
  status                 SubmissionStatus   @default(PENDING)
  adminNotes             String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model WritingPrompt {
  id                String             @id @default(cuid())
  authorId          String
  title             String
  body              String
  genre             String
  normalizedGenre   String
  status            SubmissionStatus   @default(PENDING)
  voteCount         Int                @default(0)
  usageCount        Int                @default(0)
  popularityScore   Int                @default(0)
  rewardStatus      RewardStatus       @default(NOT_ELIGIBLE)
  rewardedAt        DateTime?
  adminNotes        String?
  approvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  author            User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes             PromptVote[]
  usageEvents       PromptUsageEvent[]

  @@index([status, normalizedGenre, popularityScore])
  @@index([authorId, createdAt])
  @@index([rewardStatus, popularityScore])
}

model PromptVote {
  id        String        @id @default(cuid())
  promptId  String
  userId    String
  createdAt DateTime      @default(now())
  prompt    WritingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promptId, userId])
  @@index([userId, createdAt])
}

model PromptUsageEvent {
  id        String        @id @default(cuid())
  promptId  String
  userId    String
  eventType String        @default("USE")
  createdAt DateTime      @default(now())
  prompt    WritingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promptId, createdAt])
  @@index([userId, createdAt])
}

model UserPromptAssignment {
  id          String    @id @default(cuid())
  userId      String
  promptId    String
  assignedAt  DateTime  @default(now())
  completedAt DateTime?
  dismissedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId, assignedAt])
  @@index([userId, assignedAt])
  @@index([promptId])
}

model EntrySeries {
  id          String          @id @default(cuid())
  authorId    String
  title       String
  slug        String?         @unique
  description String?
  visibility  EntryVisibility @default(PRIVATE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  entries     Entry[]

  @@index([authorId, createdAt])
}

model Entry {
  id                String                @id @default(cuid())
  authorId          String
  seriesId          String?
  promptId          String?
  title             String?
  slug              String?               @unique
  summary           String?
  plainText         String?
  content           Json?
  wordCount         Int                   @default(0)
  privateAuthorNote String?
  publicAuthorNote  String?
  visibility        EntryVisibility       @default(PRIVATE)
  commentPolicy     CommentPolicy         @default(ENABLED)
  status            EntryStatus           @default(DRAFT)
  isNsfw            Boolean               @default(false)
  isStandalone      Boolean               @default(true)
  firstSubmittedAt  DateTime?
  publishedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  author            User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series            EntrySeries?          @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  prompt            Prompt?               @relation("PromptResponses", fields: [promptId], references: [id], onDelete: SetNull)
  likes             EntryLike[]
  comments          EntryComment[]
  progressCredits   EntryProgressCredit[]
  hiddenBy          HiddenEntry[]

  @@index([authorId, createdAt])
  @@index([seriesId, createdAt])
  @@index([visibility, status, publishedAt])
  @@index([promptId])
}

model HiddenEntry {
  id       String   @id @default(cuid())
  userId   String
  entryId  String
  hiddenAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry    Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@index([userId, hiddenAt])
  @@index([userId, entryId])
}

model EntryProgressCredit {
  id              String        @id @default(cuid())
  entryId         String
  dailyProgressId String
  creditedDate    DateTime
  creditedWords   Int
  createdAt       DateTime      @default(now())
  entry           Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  dailyProgress   DailyProgress @relation(fields: [dailyProgressId], references: [id], onDelete: Cascade)

  @@unique([entryId, dailyProgressId])
  @@index([dailyProgressId, creditedDate])
}

model EntryLike {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  createdAt DateTime @default(now())
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([userId, createdAt])
}

model EntryComment {
  id              String         @id @default(cuid())
  entryId         String
  authorId        String
  parentCommentId String?
  body            String
  isEdited        Boolean        @default(false)
  isDeleted       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  entry           Entry          @relation(fields: [entryId], references: [id], onDelete: Cascade)
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment   EntryComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         EntryComment[] @relation("CommentReplies")

  @@index([entryId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentCommentId])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  message     String?
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  acceptedAt  DateTime?
  ignoredAt   DateTime?
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}
